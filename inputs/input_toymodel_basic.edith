;This is an input file for pyEDITH
;Comments are preceded with a # or a ;
;In the comments below, ( ) indicates the units and { } indicates the data format

;Variable names cannot be changed
;Arrays are encased by [ ] and entries are separated by ,
;Scalars cannot be encased in [ ]--scalars are not the same as one-element arrays
;Spaces do not matter, empty lines do not matter

;--------------------------------
;------- REFERENCE LAMBDA -------
;--------------------------------

;--- OBSERVATIONAL PARAMETERS ---
wavelength = 0.5                            ; wavelength (micron)
snr = 7.0                                   ; signal-to-noise ratio at desired wavelength {same length as wavelength} 
CRb_multiplier  = 2.                        ; factor to multiply to remove background
photometric_aperture_radius = 0.85          ; photometric aperture radius used for plots and some basic exp time estimates, recommended = 0.7 l/D_inscribed ~ 0.85 l/D

;--- STAR PARAMETERS ---
distance = 10.                              ; distance to star (pc)
Fstar_10pc =  122.9279                      ; flux in the V band (ph/s/cm^2/nm)
FstarV_10pc =  115.59984                    ; flux at desired wavelength {same length as wavelength} (ph/s/cm^2/nm)
stellar_radius = 1                          ; stellar radius (R_sun)
nzodis = 3.0                                ; amount of exozodi around target star ("zodis")
ra = 236.0075773682300                      ; right ascension of target star used to estimate zodi (deg) 
dec = 02.5151668316500                      ; declination of target star used to estimate zodi (deg)

;--- PLANET PARAMETERS ---
separation = 0.1                            ; separation of planet (arcsec)
Fp/Fs =  1e-10                              ; planet contrast at desired wavelength {same length as wavelength} 

;--- OBSERVATORY PARAMETERS ---
observatory_preset = ToyModel
observing_mode =  IMAGER
T_optical = 0.532                             ; optical throughput 

;--- FILTERS ---
filter_name      = toy_filter
filter_center    = 0.5
filter_bandwidth = 0.2